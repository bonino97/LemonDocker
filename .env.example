# LemonDocker Configuration Example
# Copy this file to .env and fill in your API keys

# ============================================
# SYSTEM CONFIGURATION
# ============================================
RESULTS_BASE_PATH=/opt/results
MAX_PARALLEL_WORKERS=10
DEFAULT_TIMEOUT=3600

# ============================================
# CELERY CONFIGURATION
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# API KEYS FOR RECONNAISSANCE TOOLS
# ============================================

# Subfinder Configuration
# Get API keys from: https://github.com/projectdiscovery/subfinder
# Create config file at ~/.config/subfinder/provider-config.yaml
SUBFINDER_CONFIG=/root/.config/subfinder/provider-config.yaml

# ProjectDiscovery Chaos
# Get API key from: https://chaos.projectdiscovery.io/
CHAOS_KEY=your_chaos_api_key_here

# GitHub Token
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo, read:org
GITHUB_TOKEN=ghp_your_github_token_here

# Shodan API Key (for Findomain)
# Get from: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# SecurityTrails API Key (for Findomain)
# Get from: https://securitytrails.com/
SECURITYTRAILS_API_KEY=your_securitytrails_key_here

# VirusTotal API Key (for Findomain)
# Get from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# URLScan API Key
# Get from: https://urlscan.io/user/profile/
URLSCAN_API_KEY=your_urlscan_key_here

# ============================================
# TOOL CONFIGURATION
# ============================================

# Nuclei Templates Path
NUCLEI_TEMPLATES_PATH=/root/nuclei-templates

# Wordlists Path
WORDLIST_PATH=/opt/SecLists

# ============================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================

# Use legacy server instead of v2
# USE_LEGACY_SERVER=false

# Enable debug mode
# DEBUG=false

# Rate limiting
# MAX_REQUESTS_PER_MINUTE=60

# ============================================
# NOTES
# ============================================
#
# Most API keys are OPTIONAL but highly recommended for:
# - Subfinder: Enables 50+ data sources instead of just 10
# - Chaos: Access to ProjectDiscovery's subdomain datasets
# - GitHub: Find subdomains in code repositories
# - Shodan: Discover exposed services
#
# Without API keys, tools will use:
# - Public sources only
# - Limited rate limits
# - Reduced coverage
#
# With API keys, expect:
# - 5-10x more subdomains discovered
# - Faster enumeration
# - Access to historical data
#
# To add API keys after deployment:
#
# 1. Via API:
#    curl -X POST http://localhost:8000/config/env \
#      -H 'Content-Type: application/json' \
#      -d '{"key": "CHAOS_KEY", "value": "your_key", "is_sensitive": true}'
#
# 2. Via management script:
#    docker exec lemondocker lemondocker shell
#    >>> from config_manager import get_config_manager
#    >>> config = get_config_manager()
#    >>> config.set("CHAOS_KEY", "your_key", is_sensitive=True)
#
